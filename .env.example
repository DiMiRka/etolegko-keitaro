KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=

# SQLite для локальной разработки; Для докера Postgres:
# DATABASE_URL=postgresql+asyncpg://keitaro:keitaro@localhost:5432/keitaro
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Секрет для подписи cookie сессии. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Первый пользователь создаётся при старте, если в базе ещё нет пользователей
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminadmin123
# true, если сервис открыт по https
COOKIE_SECURE=false

CAMPAIGN_PREFIX=test_mironov_
KEITARO_DOMAIN_ID=1813
KEITARO_GROUP_ID=10332
KEITARO_TRAFFIC_SOURCE_ID=836

# Только для docker-compose.prod.yml, см. DEPLOY.md
